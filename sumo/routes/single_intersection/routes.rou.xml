<routes>
    <!-- ===================== VEHICLE TYPES ===================== -->
    <!-- emissionClass values come from the HBEFA3 database bundled with
         SUMO. Different classes burn fuel and emit CO2 at different rates
         per second of driving or idling; this is what makes fuel/CO2
         meaningful in the reward function later. -->

    <vType id="car" vClass="passenger" length="5.0" accel="2.6" decel="4.5"
           sigma="0.5" maxSpeed="16.6" emissionClass="HBEFA3/PC_G_EU4"
           color="0.7,0.7,0.7"/>

    <vType id="bus" vClass="bus" length="12.0" accel="1.5" decel="3.5"
           sigma="0.5" maxSpeed="13.0" emissionClass="HBEFA3/Bus"
           color="0.2,0.4,0.9"/>

    <vType id="truck" vClass="truck" length="8.0" accel="1.3" decel="3.5"
           sigma="0.5" maxSpeed="13.0" emissionClass="HBEFA3/HDV_D_EU4"
           color="0.6,0.4,0.1"/>

    <vType id="motorcycle" vClass="motorcycle" length="2.2" accel="3.5"
           decel="5.0" sigma="0.5" maxSpeed="16.6"
           emissionClass="HBEFA3/PC_G_EU4" color="0.9,0.7,0.0"/>

    <vType id="ambulance" vClass="emergency" length="6.0" accel="3.0"
           decel="5.0" sigma="0.3" maxSpeed="20.0" speedFactor="1.3"
           emissionClass="HBEFA3/LDV_D_EU4" color="1,0,0"
           guiShape="emergency"/>

    <!-- ===================== ROUTES ===================== -->
    <!-- Every possible movement through junction C: each approach can go
         straight or turn toward either of the other two directions.
         netconvert already generated the internal turning lanes in
         Phase 3; a route just needs the entry and exit edge. -->

    <!-- From North -->
    <route id="N_S" edges="N2C C2S"/>
    <route id="N_E" edges="N2C C2E"/>
    <route id="N_W" edges="N2C C2W"/>

    <!-- From South -->
    <route id="S_N" edges="S2C C2N"/>
    <route id="S_W" edges="S2C C2W"/>
    <route id="S_E" edges="S2C C2E"/>

    <!-- From East -->
    <route id="E_W" edges="E2C C2W"/>
    <route id="E_N" edges="E2C C2N"/>
    <route id="E_S" edges="E2C C2S"/>

    <!-- From West -->
    <route id="W_E" edges="W2C C2E"/>
    <route id="W_S" edges="W2C C2S"/>
    <route id="W_N" edges="W2C C2N"/>
</routes>